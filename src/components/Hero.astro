---
---

<section class="hero">
  <div class="hero__inner">
    <div class="hero__text">
      <p class="hero__eyebrow">Spiritual Life Counselling</p>
      <h1 class="hero__title">Guidance from<br />Lived Experience</h1>
      <p class="hero__subtitle">
        Over 40 years of spiritual practice and psychological self-experience —
        from music college through Indian ashrams to leading a mid-sized company.
        I accompany people in life questions, the search for meaning, and personal development.
      </p>
      <p class="hero__disclaimer">
        My counselling is not a substitute for medical, psychiatric or
        psychotherapeutic treatment. For mental health conditions I explicitly
        recommend professional help.
      </p>
      <a href="#contact" class="hero__cta">Schedule a Free Consultation</a>
    </div>

    <div class="hero__image-wrap">
      <img
        src="/Sandhan Westphal.jpg"
        alt="Sandhan Westphal – Spiritual Life Counselling Leipzig"
        class="hero__image"
      />
      <div class="hero__quote">
        <blockquote>
          "The essence of lived experience is the greatest teacher."
        </blockquote>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: 8rem 2rem 4rem;
    background-color: var(--sand);
  }

  .hero__inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .hero__eyebrow {
    font-size: 0.8rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--terracotta);
    margin-bottom: 1rem;
    animation: fadeUp 0.8s ease both;
  }

  .hero__title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    color: var(--deep);
    margin-bottom: 1.5rem;
    animation: fadeUp 0.8s 0.1s ease both;
  }

  .hero__subtitle {
    font-size: 1rem;
    color: var(--text-light);
    margin-bottom: 1.5rem;
    max-width: 480px;
    animation: fadeUp 0.8s 0.2s ease both;
  }

  .hero__disclaimer {
    font-size: 0.78rem;
    color: var(--text-light);
    border-left: 2px solid var(--warm);
    padding-left: 1rem;
    margin-bottom: 2rem;
    max-width: 440px;
    animation: fadeUp 0.8s 0.3s ease both;
  }

  .hero__cta {
    display: inline-block;
    padding: 0.85rem 2rem;
    background: var(--terracotta);
    color: #fff;
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: background 0.2s, transform 0.2s;
    animation: fadeUp 0.8s 0.4s ease both;
  }

  .hero__cta:hover {
    background: var(--deep);
    transform: translateY(-2px);
  }

  .hero__image-wrap {
    position: relative;
    animation: fadeIn 1s 0.3s ease both;
  }

  .hero__image {
    width: 100%;
    height: 580px;
    object-fit: cover;
    object-position: top center;
  }

  .hero__quote {
    position: absolute;
    bottom: -1.5rem;
    left: -1.5rem;
    background: var(--deep);
    color: var(--warm);
    padding: 1.5rem;
    max-width: 300px;
  }

  .hero__quote blockquote {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: 1rem;
    line-height: 1.6;
  }

  @media (max-width: 1024px) {
    .hero__inner { grid-template-columns: 1fr; }
    .hero__image { height: 400px; }
    .hero__quote { position: static; margin-top: 1rem; max-width: 100%; }
  }
</style>
