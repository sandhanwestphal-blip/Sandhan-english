---
---

<section class="contact" id="contact">
  <div class="contact__inner">
    <div class="contact__info">
      <p class="section__eyebrow">Contact</p>
      <h2 class="section__title">Ready for the<br /><em>Next Step?</em></h2>
      <p class="contact__lead">
        I offer you a space where your story has room — without judgement,
        but with the clarity of someone who knows the extremes of life.
      </p>

      <div class="contact__preisbox">
        <strong class="contact__preis">One session: € 80.– / hour</strong>
        <span class="contact__gratis">20-minute introductory session free of charge</span>
        <span class="contact__format">In person in Leipzig &nbsp;&middot;&nbsp; Online via Zoom</span>
      </div>

      <div class="contact__person">
        <strong>Sandhan Westphal</strong><br />
        Leipzig, Germany<br />
        <a href="mailto:sandhan.westphal@gmx.de">sandhan.westphal@gmx.de</a>
      </div>
    </div>

    <form class="contact__form" action="https://api.web3forms.com/submit" method="POST">
      <input type="hidden" name="access_key" value="e46d2f0b-7cba-4804-9431-80996bf06b2d" />
      <input type="hidden" name="subject" value="New Contact Request – Sandhan Westphal" />
      <input type="hidden" name="redirect" value="https://sandhan-english.pages.dev/?thanks=1" />
      <input type="checkbox" name="botcheck" style="display:none" />

      <div class="form__field">
        <label for="name">Name</label>
        <input type="text" id="name" name="name" required placeholder="Your name" />
      </div>

      <div class="form__field">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" required placeholder="your@email.com" />
      </div>

      <div class="form__field">
        <label for="phone">Phone (optional)</label>
        <input type="tel" id="phone" name="phone" placeholder="+49 …" />
      </div>

      <div class="form__field">
        <label for="message">Message</label>
        <textarea id="message" name="message" rows="5" required placeholder="What is on your mind?"></textarea>
      </div>

      <button type="submit" class="form__submit">Send message</button>
    </form>
  </div>
</section>

<style>
  .contact {
    padding: 7rem 2rem;
    background-color: var(--sand);
  }

  .contact__inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: start;
  }

  .section__eyebrow {
    font-size: 0.8rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--terracotta);
    margin-bottom: 0.75rem;
  }

  .section__title {
    font-size: clamp(1.8rem, 3vw, 2.8rem);
    color: var(--deep);
    margin-bottom: 1.25rem;
    line-height: 1.2;
  }

  .section__title em {
    font-style: italic;
    color: var(--terracotta);
  }

  .contact__lead {
    font-size: 0.95rem;
    color: var(--text-light);
    margin-bottom: 2.5rem;
    max-width: 380px;
  }

  .contact__preisbox {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1.5rem;
    background: var(--warm);
    border-left: 3px solid var(--terracotta);
    margin-bottom: 1.5rem;
  }

  .contact__preis {
    font-size: 1.05rem;
    color: var(--deep);
    font-weight: 500;
  }

  .contact__gratis {
    font-size: 0.88rem;
    color: var(--terracotta);
    font-weight: 500;
  }

  .contact__format {
    font-size: 0.88rem;
    color: var(--text-light);
    line-height: 1.8;
  }

  .contact__person {
    font-size: 0.92rem;
    color: var(--text);
    line-height: 1.9;
  }

  .contact__person strong {
    color: var(--deep);
    font-weight: 500;
  }

  .contact__person a {
    color: var(--terracotta);
    transition: opacity 0.2s;
  }

  .contact__person a:hover {
    opacity: 0.75;
  }

  /* Form */
  .contact__form { display: flex; flex-direction: column; gap: 1.5rem; }

  .form__field { display: flex; flex-direction: column; gap: 0.4rem; }

  .form__field label {
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-light);
  }

  .form__field input,
  .form__field textarea {
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--warm);
    padding: 0.6rem 0;
    font-family: 'Jost', sans-serif;
    font-size: 0.95rem;
    color: var(--text);
    outline: none;
    transition: border-color 0.2s;
    resize: vertical;
  }

  .form__field input:focus,
  .form__field textarea:focus { border-bottom-color: var(--terracotta); }

  .form__field input::placeholder,
  .form__field textarea::placeholder { color: var(--text-light); opacity: 0.6; }

  .form__submit {
    align-self: flex-start;
    padding: 0.85rem 2rem;
    background: var(--terracotta);
    color: #fff;
    border: none;
    font-family: 'Jost', sans-serif;
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.2s, transform 0.2s;
  }

  .form__submit:hover {
    background: var(--deep);
    transform: translateY(-2px);
  }

  @media (max-width: 1024px) {
    .contact__inner { grid-template-columns: 1fr; gap: 3rem; }
  }
</style>
