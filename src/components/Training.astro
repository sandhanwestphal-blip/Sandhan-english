---
const training = [
  {
    year: "1985–1990",
    title: "Music Conservatory",
    description: "Classical training. Foundation of discipline, precision and awareness of inner states.",
  },
  {
    year: "1992–1998",
    title: "Ashram Stays, India",
    description: "Intensive practice in Vipassana and ZaZen. Work with teachers from various spiritual traditions.",
  },
  {
    year: "2005",
    title: "NLP Practitioner & Master",
    description: "Certified training in Neuro-Linguistic Programming. Communication, change work, belief systems.",
  },
  {
    year: "2010",
    title: "Hypnosis after Milton Erickson",
    description: "Training in Ericksonian hypnosis and trance work. Therapeutic application in counselling.",
  },
  {
    year: "2012",
    title: "Reiki & Bodywork",
    description: "Energetic bodywork and Reiki. Integration into holistic counselling practice.",
  },
  {
    year: "2015",
    title: "Trauma Healing",
    description: "Further training in trauma-sensitive accompaniment. Work with deep-seated patterns and imprints.",
  },
];
---

<section class="training" id="training">
  <div class="training__inner">
    <div class="training__header">
      <p class="section__eyebrow">Training</p>
      <h2 class="section__title">Foundation of the Work</h2>
    </div>

    <div class="training__grid">
      {training.map((t) => (
        <div class="training__entry">
          <span class="training__year">{t.year}</span>
          <div class="training__content">
            <h3 class="training__title">{t.title}</h3>
            <p class="training__text">{t.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .training {
    padding: 7rem 2rem;
    background-color: var(--deep);
    color: var(--warm);
  }

  .training__inner { max-width: 1200px; margin: 0 auto; }
  .training__header { margin-bottom: 3.5rem; }

  .section__eyebrow {
    font-size: 0.8rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--terracotta);
    margin-bottom: 0.75rem;
  }

  .section__title { font-size: clamp(1.8rem, 3vw, 2.8rem); color: var(--warm); }

  .training__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0; }

  .training__entry {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 1.5rem;
    padding: 1.75rem 2rem 1.75rem 0;
    border-bottom: 1px solid rgba(232, 221, 208, 0.15);
    transition: background 0.2s;
  }

  .training__entry:hover { background: rgba(232, 221, 208, 0.04); }

  .training__year {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1rem;
    color: var(--terracotta);
    font-weight: 300;
    padding-top: 0.15rem;
    white-space: nowrap;
  }

  .training__title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.2rem;
    color: var(--warm);
    font-weight: 400;
    margin-bottom: 0.4rem;
  }

  .training__text { font-size: 0.88rem; color: rgba(232, 221, 208, 0.7); line-height: 1.6; }

  @media (max-width: 1024px) {
    .training__grid { grid-template-columns: 1fr; }
    .training__entry { padding-right: 0; }
  }

  @media (max-width: 600px) {
    .training__entry { grid-template-columns: 1fr; gap: 0.5rem; }
  }
</style>
