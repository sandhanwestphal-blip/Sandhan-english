---
const competencies = [
  {
    title: "Psychology",
    items: [
      "NLP Practitioner (Richard Bandler)",
      "Hypnosis after Milton Erickson",
      "Trauma healing",
      "Happiness training",
    ],
  },
  {
    title: "Meditation",
    items: [
      "Vipassana",
      "ZaZen",
      "Osho meditations",
      "Over 40 years of practice",
    ],
  },
  {
    title: "Coaching",
    items: [
      "Personal Power (Tony Robbins)",
      "Reiki Master",
      "Questions of meaning & life transitions",
      "Professional turning points",
    ],
  },
  {
    title: "Bodywork",
    items: [
      "Rebalancing deep tissue massage",
      "Spinal Adjustment / Chiropractic",
      "Root massage",
      "Dominant massage",
    ],
  },
];
---

<section class="competencies" id="competencies">
  <div class="competencies__inner">
    <div class="competencies__header">
      <p class="section__eyebrow">Competencies &amp; Methods</p>
      <h2 class="section__title">Body, Mind and Soul as One</h2>
    </div>

    <div class="competencies__grid">
      {competencies.map((c) => (
        <div class="competency__card">
          <div class="competency__icon" aria-hidden="true">
            <span></span><span></span><span></span>
          </div>
          <h3 class="competency__title">{c.title}</h3>
          <ul class="competency__list">
            {c.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .competencies {
    padding: 7rem 2rem;
    background-color: var(--sand);
  }

  .competencies__inner { max-width: 1200px; margin: 0 auto; }
  .competencies__header { margin-bottom: 3.5rem; }

  .section__eyebrow {
    font-size: 0.8rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--terracotta);
    margin-bottom: 0.75rem;
  }

  .section__title { font-size: clamp(1.8rem, 3vw, 2.8rem); color: var(--deep); }

  .competencies__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
  }

  .competency__card {
    background: var(--warm);
    padding: 2rem 1.75rem;
    transition: transform 0.2s, background 0.2s;
  }

  .competency__card:hover { background: #ddd0c0; transform: translateY(-4px); }

  .competency__icon {
    display: flex;
    flex-direction: column;
    gap: 5px;
    margin-bottom: 1.25rem;
    width: 28px;
  }

  .competency__icon span { display: block; height: 1.5px; background: var(--terracotta); }
  .competency__icon span:nth-child(2) { width: 70%; }
  .competency__icon span:nth-child(3) { width: 45%; }

  .competency__title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.3rem;
    color: var(--deep);
    margin-bottom: 1rem;
    font-weight: 400;
  }

  .competency__list { list-style: none; display: flex; flex-direction: column; gap: 0.5rem; }

  .competency__list li {
    font-size: 0.88rem;
    color: var(--text);
    padding-left: 1rem;
    position: relative;
  }

  .competency__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 5px;
    height: 1px;
    background: var(--terracotta);
  }

  @media (max-width: 1024px) { .competencies__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px)  { .competencies__grid { grid-template-columns: 1fr; } }
</style>
